# SITE/_headers, written by the generator (never by hand). Cloudflare Workers static assets and Pages both read it.
# While the site is NOT indexable yet: keep the X-Robots-Tag line and DROP the "https://example.com/*" block
#   (noindex everywhere, on every host).
# Once it is indexable: keep BOTH. The canonical domain is detached from the noindex ("! X-Robots-Tag"), and every
#   preview host (pages.dev, workers.dev, the agency preview subdomain, deployment hashes) stays noindex forever.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  X-Robots-Tag: noindex, nofollow

https://example.com/*
  ! X-Robots-Tag

# A year of cache ONLY because the generator versions every asset URL it writes (?v=<hash of the file>, or the
# hash in the file name). An unversioned file replaced under the same name would stay stale for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
